# Copia este archivo a ".env" y cambia los valores. El archivo ".env" real NUNCA se sube a Git.
# Todos los valores de abajo son de ejemplo y NO son secretos reales.

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=extra_liebres
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=extra_liebres
# "db" es el nombre del servicio en Docker Compose. Si corres el backend FUERA de Docker usa 127.0.0.1
# (mejor que "localhost", que en Windows tarda varios segundos en conectar).
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Solo en producción (Neon/Render): URL completa que da el proveedor. Si se define, tiene prioridad
# sobre las piezas POSTGRES_* de arriba. En desarrollo déjala comentada.
# DATABASE_URL=postgresql://usuario:contrasena@host/basedatos

# --- Backend (FastAPI) ---
# "desarrollo" o "produccion". En producción el backend NO arranca con la SECRET_KEY de este ejemplo.
ENTORNO=desarrollo
# Genera una clave larga y aleatoria, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Dominio(s) permitidos por CORS (el del frontend), separados por comas. No usar "*".
CORS_ORIGINS=http://localhost:5173

# --- Servicio externo (Open-Meteo, no requiere llave) ---
CLIMA_URL=https://api.open-meteo.com/v1/forecast
CLIMA_UMBRAL_LLUVIA=50

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000

# --- Usuarios de prueba para el seed ---
# Solo para desarrollo. En producción el seed se niega a usar estas contraseñas de ejemplo: define las tuyas.
SEED_ADMIN_CORREO=admin@ejemplo.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-admin1
SEED_CAPTURISTA_CORREO=capturista@ejemplo.com
SEED_CAPTURISTA_PASSWORD=cambia-esta-clave-capt1
